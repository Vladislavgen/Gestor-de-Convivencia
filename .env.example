# Copiar a .env cuando se conecten Firebase y Gemini.
# .env no se versiona. Este ejemplo sí.

# Configuración pública del cliente web de Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Clave de Gemini. No usar el prefijo VITE_: no debe quedar en el bundle del navegador.
GEMINI_API_KEY=
